# Application
ATLAS_APP_NAME="Atlas Agent Platform"
ATLAS_APP_VERSION="0.1.0"
ATLAS_ENVIRONMENT="local"
ATLAS_DEBUG="false"

# Model gateway
ATLAS_LLM_PROVIDER="mock"
ATLAS_LLM_MODEL="mock-model"
ATLAS_LLM_TIMEOUT_SECONDS="30"
ATLAS_LLM_MAX_RETRIES="2"

# Required only when using a remote model provider.
# Uncomment these lines in your local .env and never commit real secrets.
# ATLAS_LLM_BASE_URL="https://api.example.com/v1"
# ATLAS_LLM_API_KEY="replace-with-your-real-api-key"